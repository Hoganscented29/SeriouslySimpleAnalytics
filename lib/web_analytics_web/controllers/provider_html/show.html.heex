<div class="min-h-screen bg-base-200/40">
  <.site_header current_scope={@current_scope} active={:web} />

  <article class="mx-auto max-w-6xl px-4 sm:px-6">
    <!-- hero -->
    <header class="pt-14 pb-8 max-w-3xl">
      <nav class="text-xs text-base-content/50 mb-4" aria-label="Breadcrumb">
        <a href={~p"/"} class="hover:text-primary">Website analytics</a>
        <span class="mx-1">/</span>
        <a href={~p"/ai-crawler-analytics"} class="hover:text-primary">AI crawler analytics</a>
        <span class="mx-1">/</span>
        <span>{@provider.name}</span>
      </nav>

      <div class="badge badge-primary badge-outline mb-4">Free · {@provider.vendor}</div>
      <h1 class="text-4xl sm:text-5xl font-semibold tracking-tight leading-tight">
        {provider_keyword(@provider)}
      </h1>
      <p class="mt-3 text-xl text-base-content/60">Analytics for {@provider.name}</p>
      <p class="mt-5 text-lg text-base-content/70 leading-relaxed">{@provider.lede}</p>

      <div class="mt-7 flex flex-wrap items-center gap-3">
        <.cta current_scope={@current_scope} />
        <a href="#setup" class="btn btn-outline">How it works</a>
      </div>
    </header>

    <div class="lg:grid lg:grid-cols-[1fr_18rem] lg:gap-10 pb-16">
      <div class="min-w-0 space-y-12">
        <!-- quick facts -->
        <section class="rounded-box bg-base-100 border border-base-300 p-5">
          <h2 class="text-sm font-medium uppercase tracking-wide text-base-content/60">
            {@provider.name} at a glance
          </h2>
          <dl class="mt-4 grid sm:grid-cols-2 gap-x-8 gap-y-2 text-sm">
            <div :for={{label, value} <- @provider.facts} class="flex justify-between gap-4 py-1">
              <dt class="text-base-content/60">{label}</dt>
              <dd class="font-medium text-right">{value}</dd>
            </div>
          </dl>
        </section>

        <section :for={section <- @provider.sections} id={section.id} class="scroll-mt-8">
          <h2 class="text-2xl font-semibold tracking-tight mb-4">{section.heading}</h2>
          <.prose body={section.body} agents={@provider.agents} />
        </section>

        <!-- install -->
        <section id="install" class="scroll-mt-8">
          <h2 class="text-2xl font-semibold tracking-tight mb-4">The whole integration</h2>
          <p class="text-base-content/80 leading-relaxed">
            Paste this into the <code class="font-mono text-sm">&lt;head&gt;</code>
            of your pages. {@provider.name} traffic starts appearing in the crawlers report as it
            arrives.
          </p>
          <pre class="mt-4 bg-base-200 rounded p-4 text-xs sm:text-sm overflow-x-auto"><code>{script_tag(@base_url, @site_key)}</code></pre>
          <div class="mt-5 flex flex-wrap gap-3">
            <.cta current_scope={@current_scope} class="btn btn-primary btn-sm" />
            <.link href={~p"/demo"} class="btn btn-outline btn-sm">See it capturing, live</.link>
          </div>
        </section>

        <!-- faq -->
        <section id="faq" class="scroll-mt-8">
          <h2 class="text-2xl font-semibold tracking-tight mb-4">
            {@provider.name} analytics: frequently asked questions
          </h2>
          <div class="space-y-3">
            <details
              :for={{question, answer} <- @provider.faq}
              class="rounded-box bg-base-100 border border-base-300 px-5 py-4"
            >
              <summary class="cursor-pointer font-medium">{question}</summary>
              <p class="mt-3 text-base-content/80 leading-relaxed">{answer}</p>
            </details>
          </div>
        </section>

        <!-- other providers -->
        <section id="providers" class="scroll-mt-8">
          <h2 class="text-2xl font-semibold tracking-tight mb-2">The other AI crawlers</h2>
          <p class="text-base-content/70 mb-5">{@provider.related_note}</p>
          <div class="grid sm:grid-cols-2 gap-3">
            <a
              :for={other <- other_providers(@provider)}
              href={provider_path(other)}
              class="rounded-box bg-base-100 border border-base-300 p-4 hover:border-primary transition-colors"
            >
              <div class="font-medium">{provider_keyword(other)}</div>
              <div class="text-sm text-base-content/60 mt-1">{other.vendor}</div>
            </a>
          </div>
        </section>
      </div>

      <!-- contents -->
      <aside class="hidden lg:block">
        <nav class="sticky top-8 text-sm">
          <div class="font-medium mb-3">On this page</div>
          <ul class="space-y-2 border-l border-base-300">
            <li :for={section <- @provider.sections}>
              <a
                href={"##{section.id}"}
                class="block pl-4 -ml-px border-l border-transparent hover:border-primary hover:text-primary text-base-content/70"
              >
                {section.heading}
              </a>
            </li>
            <li>
              <a
                href="#faq"
                class="block pl-4 -ml-px border-l border-transparent hover:border-primary hover:text-primary text-base-content/70"
              >
                Frequently asked questions
              </a>
            </li>
          </ul>
        </nav>
      </aside>
    </div>
  </article>

  <.site_footer />
</div>
