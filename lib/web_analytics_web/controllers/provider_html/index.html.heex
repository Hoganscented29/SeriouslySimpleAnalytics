<div class="min-h-screen bg-base-200/40">
  <.site_header current_scope={@current_scope} active={:web} />

  <section class="mx-auto max-w-6xl px-4 sm:px-6 pt-16 pb-10">
    <div class="max-w-3xl">
      <div class="badge badge-primary badge-outline mb-4">Free · AI crawler analytics</div>
      <h1 class="text-4xl sm:text-5xl font-semibold tracking-tight leading-tight">
        Every major AI crawler, named.
      </h1>
      <p class="mt-5 text-lg text-base-content/70 leading-relaxed">
        Your analytics almost certainly shows you none of this traffic, because AI crawlers do
        not run JavaScript and JavaScript is the only thing most trackers can see. These pages
        cover each provider: the exact user agents, which robots.txt token controls it, what a
        visit actually means, and how to measure it. One script tag, free, self-hostable.
      </p>
      <div class="mt-7 flex flex-wrap gap-3">
        <.cta current_scope={@current_scope} />
        <a href={~p"/"} class="btn btn-outline">Website analytics</a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 sm:px-6 pb-20">
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
      <a
        :for={provider <- @providers}
        href={provider_path(provider)}
        class="rounded-box bg-base-100 border border-base-300 p-5 hover:border-primary transition-colors"
      >
        <div class="text-xs uppercase tracking-wide text-base-content/50">{provider.vendor}</div>
        <div class="text-lg font-medium mt-1">{provider_keyword(provider)}</div>
        <p class="mt-2 text-sm text-base-content/60 leading-relaxed">
          {provider.description}
        </p>
        <div class="mt-3 flex flex-wrap gap-1">
          <span
            :for={agent <- Enum.take(provider.agents, 3)}
            class="badge badge-outline badge-sm font-mono text-[11px]"
          >
            {agent.token}
          </span>
        </div>
      </a>
    </div>
  </section>

  <.site_footer />
</div>
