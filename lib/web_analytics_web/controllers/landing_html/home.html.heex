<div class="min-h-screen bg-base-200/40">
  <.site_header current_scope={@current_scope} active={:web} />

  <!-- hero -->
  <section class="mx-auto max-w-6xl px-4 sm:px-6 pt-16 pb-10">
    <div class="max-w-3xl">
      <h1 class="badge badge-primary badge-outline mb-4">Free · Website analytics</h1>
      <h2 class="text-4xl sm:text-5xl font-semibold tracking-tight leading-tight">
        <span class="underline decoration-primary decoration-4 underline-offset-[6px]">Free Unlimited</span>
        Website Analytics that<br class="hidden lg:inline" /> Just Works.
      </h2>
      <p class="mt-5 text-lg text-base-content/70 leading-relaxed">
        One
        <code class="font-mono text-[0.92em] bg-base-300 rounded px-1.5 py-0.5">&lt;script&gt;</code>
        tag: <strong class="font-semibold text-base-content">Dwell Time</strong>
        separated from engaged time, how far down each page anyone scrolled, easy
        page-to-page flow charts, every button/link clicked, and every form someone started
        and gave up on. No tagging plan, no bill.
      </p>
    </div>

    <div class="mt-8 rounded-box bg-base-100 border border-base-300 p-5 sm:p-6">
      <.dashboard_preview />
      <div class="mt-4 flex flex-wrap items-center gap-3">
        <%!-- No cursor on this one: the live panel sits directly beneath it and
        is already the moving thing on this part of the page. --%>
        <.cta current_scope={@current_scope} class="btn btn-primary btn-sm" />
        <span class="text-sm text-base-content/50">
          One
          <code class="font-mono text-[0.92em] bg-base-300 rounded px-1.5 py-0.5">&lt;script&gt;</code>
          tag. Everything above, from the first visit.
        </span>
      </div>
    </div>
  </section>

  <!-- the tag, demonstrated on the reader -->
  <section class="mx-auto max-w-6xl px-4 sm:px-6 pb-12">
    <.live_proof crawler_summary={@crawler_summary} />
    <script src={~p"/wa-live.js"} defer>
    </script>
  </section>

  <!-- why -->
  <section class="mx-auto max-w-6xl px-4 sm:px-6 pb-16">
    <div class="grid md:grid-cols-3 gap-4">
      <div class="rounded-box bg-base-100 border border-base-300 p-5">
        <div class="text-sm font-medium">Nothing to tag</div>
        <p class="mt-2 text-sm text-base-content/60">
          Clicks, outbound links, forms and scroll depth are captured on their own, grouped by the
          id and class already on the element. You don't annotate your markup to get data out of
          it.
        </p>
      </div>
      <div class="wa-pulse rounded-box bg-base-100 border border-base-300 p-5">
        <div class="text-sm font-medium">Unlimited</div>
        <p class="mt-2 text-sm text-base-content/60">
          Throw as much traffic at this analytics as you can! Add all your domains! It's literally
          <strong class="font-semibold text-base-content">unlimited.</strong>
        </p>
      </div>
      <div class="wa-pulse wa-pulse-offset rounded-box bg-base-100 border border-base-300 p-5">
        <div class="text-sm font-medium">Free</div>
        <p class="mt-2 text-sm text-base-content/60">
          No plan, no event quota, no sampling above a traffic line. Everything should just work.
        </p>
      </div>
    </div>
  </section>

  <!-- what you get -->
  <section id="capture" class="border-y border-base-300 bg-base-100">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 py-16">
      <h3 class="text-2xl font-semibold tracking-tight">What the script tag gets you</h3>
      <p class="mt-3 text-base-content/70 max-w-2xl">
        All of it, from the same snippet, with no configuration.
      </p>

      <div class="mt-8 grid md:grid-cols-2 lg:grid-cols-4 gap-4">
        <div
          :for={
            {item, index} <-
              Enum.with_index([
                {"Free Unlimited Analytics",
                 "Unmetered metrics for your website, beautifully displayed."},
                {"Dwell vs. engaged time",
                 "Counted separately. A tab left open all afternoon is hours of dwell and almost no engagement."},
                {"Max scroll depth", "How far down each page a visitor actually got."},
                {"Page-to-page flow",
                 "By URL or title. Click any page to re-centre the diagram and follow a route."},
                {"Outbound clicks",
                 "Caught on mousedown, before the browser tears the page down."},
                {{:safe, ~s|Every button and <span class="underline">link</span>|},
                 "Grouped by the id, class and text already on the element. No tagging plan."},
                {"Forms, field by field",
                 "On submit and on abandonment. Passwords are masked in the browser and never sent."},
                {"City, county, state, country",
                 "Resolved at ingest. The address is masked to its first and last group before anything is written; the full value never reaches the database."},
                {"Junk filtered, not hidden",
                 "Impossible dwell times are held back by default, with the reason shown and a toggle to see them."}
              ])
          }
          class={
            [
              "rounded-box p-5 transition-colors",
              # The first card answers what it costs. Everything after it describes
              # behaviour, which is a question you only reach once that one is
              # settled — so it carries the emphasis rather than sitting level
              # with the rest.
              index == 0 && "border-2 border-primary bg-primary/5 hover:bg-primary/10",
              index != 0 && "border border-base-300 hover:border-primary/50 hover:bg-base-200/70"
            ]
          }
        >
          <div class={["text-sm font-medium", index == 0 && "text-primary"]}>
            {elem(item, 0)}
          </div>
          <p class={[
            "mt-2 text-sm",
            index == 0 && "text-base-content/80",
            index != 0 && "text-base-content/60"
          ]}>
            {elem(item, 1)}
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- crawlers -->
  <section id="crawlers" class="mx-auto max-w-6xl px-4 sm:px-6 py-16">
    <h3 class="text-2xl font-semibold tracking-tight">
      You can see which AI is reading your site
    </h3>
    <p class="mt-3 text-base-content/70 max-w-2xl">
      Every crawler below is recognised by name, kept out of your visitor counts, and reported
      separately — which pages it took, how often, and when it started.
    </p>
    <div class="mt-6 flex flex-wrap gap-2">
      <span
        :for={{name, vendor} <- ai_crawlers()}
        class="badge badge-outline badge-lg font-mono text-xs transition-colors cursor-default hover:badge-primary hover:border-primary"
        title={vendor}
      >
        {name}
      </span>
    </div>
  </section>

  <!-- ai analytics cross-link -->
  <section class="mx-auto max-w-6xl px-4 sm:px-6 pt-16 pb-8">
    <div class="rounded-box bg-base-100 border border-base-300 p-6 sm:p-8">
      <h3 class="text-2xl font-semibold tracking-tight mb-6">
        Building an AI tool, not just a website?
      </h3>

      <.integration_chat base_url={@base_url} />

      <div class="mt-6">
        <.nudged_cta delay="1.3s">
          <a href={ai_path()} class="btn btn-primary btn-lg">AI tool analytics →</a>
        </.nudged_cta>
      </div>
    </div>
  </section>

  <!-- cta -->
  <section class="border-t border-base-300 bg-base-100">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 py-10 text-center">
      <h3 class="text-2xl font-semibold tracking-tight">
        Start <strong class="font-bold">collecting</strong> in less than a minute.
      </h3>
      <p class="mt-3 text-base-content/70">
        Create an account, copy the snippet, paste it in your <code class="font-mono text-[0.92em] bg-base-300 rounded px-1.5 py-0.5">&lt;head&gt;</code>.
      </p>
      <div class="mt-6 flex flex-wrap gap-3 justify-center">
        <.nudged_cta>
          <.cta current_scope={@current_scope} />
        </.nudged_cta>
      </div>
    </div>
  </section>

  <.site_footer />
</div>
