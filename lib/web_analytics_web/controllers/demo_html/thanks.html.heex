<.page site_key={@site_key} title="Acme — Thanks">
  <h1>You're in</h1>
  <p>
    The submission was captured with every field value. Open the <strong>Forms</strong>
    tab on the dashboard to see it, including which fields were edited and how long
    each one held focus.
  </p>
  <div class="row">
    <a href={~p"/dashboard"} class="btn btn-primary">Open dashboard</a>
    <a href={~p"/demo"} class="btn">Back to the demo</a>
  </div>
</.page>
