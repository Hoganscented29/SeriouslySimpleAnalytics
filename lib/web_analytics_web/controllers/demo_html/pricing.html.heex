<.page site_key={@site_key} title="Acme — Pricing" active="pricing">
  <h1>Pricing</h1>
  <p>
    Fill in the form below — then either submit it or navigate away to see both paths recorded.
  </p>

  <div class="card">
    <form id="signup" name="signup" class="signup-form" action={~p"/demo/signup"} method="post">
      <input type="hidden" name="_csrf_token" value={Phoenix.Controller.get_csrf_token()} />

      <label for="full_name">Full name</label>
      <input type="text" id="full_name" name="full_name" placeholder="Ada Lovelace" />

      <label for="email">Work email</label>
      <input type="email" id="email" name="email" placeholder="ada@example.com" />

      <label for="password">Password</label>
      <input type="password" id="password" name="password" />
      <span class="muted">Masked in the browser — never sent.</span>

      <label for="plan">Plan</label>
      <select id="plan" name="plan">
        <option value="starter">Starter</option>
        <option value="pro" selected>Pro</option>
        <option value="enterprise">Enterprise</option>
      </select>

      <label for="seats">Seats</label>
      <input type="text" id="seats" name="seats" value="5" />

      <label for="notes">Anything else?</label>
      <textarea id="notes" name="notes" rows="3"></textarea>

      <div class="check">
        <input type="checkbox" id="newsletter" name="newsletter" value="yes" />
        <label for="newsletter" style="margin:0">Send me product updates</label>
      </div>

      <div class="row">
        <button type="submit" id="signup-submit" class="btn btn-primary">Create account</button>
        <a href={~p"/demo/docs"} id="abandon-link" class="btn">Read the docs first</a>
      </div>
    </form>
  </div>

  <p class="muted">
    Leaving this page with the form partly filled records it as <code>abandoned</code>,
    with whatever was typed so far.
  </p>
</.page>
