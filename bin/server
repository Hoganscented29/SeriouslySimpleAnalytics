#!/usr/bin/env bash
#
# Launch SeriouslySimpleAnalytics.
#
#   bin/server              # start on port 4001
#   PORT=4005 bin/server    # start somewhere else
#   MIX_ENV=prod bin/server # production mode
#
# Sets up whatever is missing — dependencies, the database, assets — then runs
# the server in the foreground. Safe to re-run; every step is idempotent.

set -euo pipefail

cd "$(dirname "$0")/.."

# This box already runs another Phoenix app, so nothing here may assume the
# usual 4000.
PORT="${PORT:-4001}"
MIX_ENV="${MIX_ENV:-dev}"
export PORT MIX_ENV

say() { printf '\033[1;36m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m warn\033[0m %s\n' "$*"; }
die() { printf '\033[1;31merror\033[0m %s\n' "$*" >&2; exit 1; }

command -v mix >/dev/null 2>&1 || die "Elixir is not installed, or mix is not on PATH."

# -- port ------------------------------------------------------------------

# -sTCP:LISTEN matters: without it lsof also matches processes that merely have
# an open *connection* to this port, and a passing client would block startup.
if lsof -ti tcp:"$PORT" -sTCP:LISTEN >/dev/null 2>&1; then
  holder="$(lsof -ti tcp:"$PORT" -sTCP:LISTEN | head -1)"
  name="$(ps -p "$holder" -o comm= 2>/dev/null || echo 'unknown')"
  die "Port $PORT is already in use by pid $holder ($name).
      Stop it, or start this one elsewhere:  PORT=4005 bin/server"
fi

# -- database --------------------------------------------------------------

if ! pg_isready -q 2>/dev/null; then
  die "Postgres is not accepting connections.
      Start it first, e.g.  brew services start postgresql@16"
fi

say "Installing dependencies"
mix deps.get --quiet

say "Preparing the database"
mix ecto.create --quiet
mix ecto.migrate

# -- geolocation -----------------------------------------------------------

if [ -z "$(ls priv/geoip/*.mmdb 2>/dev/null)" ]; then
  warn "No GeoIP database found — visitor location will fall back to CDN headers,"
  warn "then to a country-level guess from the browser time zone."
  warn "For city-level data run:  mix geoip.download"
fi

# -- assets ----------------------------------------------------------------

if [ "$MIX_ENV" = "prod" ]; then
  say "Building assets"
  mix assets.deploy
fi

# -- go --------------------------------------------------------------------

say "Starting on http://localhost:$PORT  (MIX_ENV=$MIX_ENV)"
printf '    landing    http://localhost:%s/\n' "$PORT"
printf '    dashboard  http://localhost:%s/dashboard\n' "$PORT"
printf '    llms.txt   http://localhost:%s/llms.txt\n' "$PORT"
printf '    ping API   http://localhost:%s/api/ping?uid=ACCOUNT&event=test\n\n' "$PORT"

exec mix phx.server
