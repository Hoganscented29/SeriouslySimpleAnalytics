# Copy to .env and fill in. No `export` prefixes — systemd's EnvironmentFile=
# cannot parse them, and sourcing under `set -a` exports everything anyway.
# install.sh writes this file for you; this copy
# exists to document what the application reads.
#
# .env is gitignored. So is every .env.* variant, and this example is the one
# exception — keep it free of real values.

# Required in production. The application refuses to start without it.
# Contact me@LoganBesecker.com for a key.
SSA_LICENSE_KEY=

# Required in production. Generate with: mix phx.gen.secret
SECRET_KEY_BASE=

# Required in production.
DATABASE_URL=ecto://user@localhost/seriously_simple_analytics_prod

# Salts the day-rotating IP hash. Defaults to SECRET_KEY_BASE if unset, which is
# fine — set it only if you want the two rotated independently.
IP_SALT=

# How this deployment is reached from outside. /llms.txt publishes absolute URLs
# built from these, so set them to the public address before pointing anyone at
# it, or integrating agents get a link to the wrong host.
PHX_HOST=localhost
PHX_SCHEME=http
PHX_PORT=4001

# Port to bind. This box already runs another Phoenix app, hence not 4000.
PORT=4001
MIX_ENV=prod

# Account email, via Mailgun. Without a key, registration and sign-in links are
# written to the log instead of being delivered — the application still runs,
# but nobody can get into an account.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=csuitenecessities.com
MAIL_FROM=logan@csuitenecessities.com
