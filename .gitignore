# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where 3rd-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Temporary files, for example, from tests.
/tmp/

# Ignore package tarball (built via "mix hex.build").
web_analytics-*.tar

# Ignore assets that are produced by build tools.
/priv/static/assets/

# Ignore digested assets cache.
/priv/static/cache_manifest.json

# Digested copies and gzipped variants written by `mix phx.digest`, which
# `mix assets.deploy` runs. They are build output of a deploy, not source: the
# 32 question marks match the content hash Phoenix appends to each filename.
/priv/static/**/*-????????????????????????????????.*
/priv/static/**/*.gz

# In case you use Node.js/npm, you want to ignore these.
npm-debug.log
/assets/node_modules/


# GeoIP databases are large, reissued monthly, and fetched with `mix geoip.download`.
/priv/geoip/*.mmdb
/priv/geoip/*.mmdb.gz

# ---------------------------------------------------------------------------
# Secrets
#
# These patterns are deliberately wider than the files that exist today. Secrets
# do not leak as `.env` — they leak as `.env.production`, as the `.bak` someone
# made before editing, as the copy left in the repo root. Matching only the
# canonical name catches only the case nobody gets wrong.
# ---------------------------------------------------------------------------

# Any environment file, in any form. The example is the one exception.
.env
.env.*
!.env.example

# The licensor private key — and every copy of it. Anyone holding this can mint
# deployment keys that released builds accept. The README asks you to back it
# up, and `cp priv/licensor_private_key priv/licensor_private_key.bak` is the
# obvious way to do that, so the pattern has to cover the copy too.
*licensor_private_key*

# Keys, certificates and credential stores by extension.
*.pem
*.key
*.p12
*.pfx
*.keystore
id_rsa*
id_ed25519*

# Database dumps, which carry whatever was in the database.
*.sql
*.dump
!priv/repo/structure.sql

# macOS directory metadata.
.DS_Store
